FROM registry.nexdev.net:5050/docker/haproxy/haproxy-debian:2.4 AS base
COPY configs/prod /usr/local/etc/haproxy/configs/prod
RUN ls /usr/local/etc/haproxy/configs
RUN cat /usr/local/etc/haproxy/configs/prod/*.cfg > /usr/local/etc/haproxy/configs/prod/haproxy.cfg.tmp
RUN cp /usr/local/etc/haproxy/configs/prod/haproxy.cfg.tmp /usr/local/etc/haproxy/haproxy.cfg
RUN cat /usr/local/etc/haproxy/haproxy.cfg
COPY whitelisted.ips /etc/haproxy/whitelisted.ips
COPY configs/prod/maps/hosts.map /usr/local/etc/haproxy/hosts.map
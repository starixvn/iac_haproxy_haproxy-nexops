FROM registry.nexdev.net:5050/docker/haproxy/haproxy-debian:2.4 AS base

# Install software 
RUN apt-get update
RUN apt-get install -y git
# Make ssh dir
# Copy over private key, and set permissions
# Warning! Anyone who gets their hands on this image will be able
# to retrieve this private key file from the corresponding image layer
ADD repo-key /
RUN \
  chmod 600 /repo-key && \  
  echo "IdentityFile /repo-key" >> /etc/ssh/ssh_config && \  
  echo -e "StrictHostKeyChecking no" >> /etc/ssh/ssh_config
# Create known_hosts
#RUN touch /root/.ssh/known_hosts
# Add bitbuckets key
#RUN ssh-keyscan gitlab.nexdev.net >> /root/.ssh/known_hosts
# Clone the conf files into the docker container
RUN git clone git@gitlab.nexdev.net:NEXOPS/haproxy/haproxy-default.git
#############
COPY configs/local_test /usr/local/etc/haproxy/configs/local_test
RUN ls /usr/local/etc/haproxy/configs/local_test
RUN cat /usr/local/etc/haproxy/configs/local_test/*.cfg > /usr/local/etc/haproxy/configs/local_test/haproxy.cfg.tmp
RUN cp /usr/local/etc/haproxy/configs/local_test/haproxy.cfg.tmp /usr/local/etc/haproxy/haproxy.cfg
#COPY whitelisted.ips /etc/haproxy/whitelisted.ips
#COPY certs/nexdev.net.pem /etc/haproxy/nexdev.net.pem
#COPY certs/nexcel.vn.pem /etc/haproxy/nexcel.vn.pem
#COPY configs/local_test/maps/hosts.map /etc/haproxy/hosts.map
RUN mkdir /usr/local/etc/haproxy/maps
RUN cat /usr/local/etc/haproxy/configs/local_test/maps/*.map > /usr/local/etc/haproxy/maps/hosts.map
RUN cp /usr/local/etc/haproxy/configs/local_test/special-maps/l2-game-proxy.map /usr/local/etc/haproxy/maps/l2-game-proxy.map
RUN cat /usr/local/etc/haproxy/haproxy.cfg
RUN cat /etc/haproxy/maps/hosts.map